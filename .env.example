# ==========================================
# DISCORD ACTIVE DEVELOPER BADGE BOT CONFIG
# ==========================================

# Your Main Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your Discord Application (Client) ID
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Comma-separated list of Discord User IDs who have Owner/Admin permissions
# Example: OWNER_IDS=764180361559146556,123456789012345678
OWNER_IDS=764180361559146556

# Default command prefix for prefix commands (e.g. !, ?, -)
DEFAULT_PREFIX=!

# ProBot Application ID (Default: 282859044593598464)
PROBOT_ID=282859044593598464
